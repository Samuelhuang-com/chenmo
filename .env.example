# 複製成 .env 後修改（.env 不要上傳 GitHub）
SECRET_KEY=請改成一串隨機長字串
# 資料儲存：sqlite（本機，存檔不會消失）／firestore（Google Cloud）／memory（重啟即清空）
REPO_BACKEND=sqlite
# SQLITE_PATH=~/.chenmo/chenmo.db
# REPO_BACKEND=firestore
# GCP_PROJECT=chenmo-xxxxxx

# 本機開發用老師密碼（正式環境請留空，改用 Google 登入）
MASTER_PASSWORD=dev123

# Google 登入（在 Google Cloud Console > API 和服務 > 憑證 建立）
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
# MASTER_EMAILS=你的信箱@gmail.com

# AI 解字草稿（選填）：到 https://console.anthropic.com 建立 API Key
# 沒填也能帶出部首、筆畫、五行、說文、辭典字義；只有 AI 補充與「解讀」草稿需要它
# ANTHROPIC_API_KEY=sk-ant-xxxx

# 新問字 Email 通知（選填）：Gmail 需先開啟兩步驟驗證，再到 https://myaccount.google.com/apppasswords 建立應用程式密碼
# SMTP_USER=你的信箱@gmail.com
# SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# NOTIFY_EMAILS=收件人@gmail.com      # 留空則寄給 MASTER_EMAILS

# 學生是否必須用 Google 登入才能問字（預設 true；需設定 GOOGLE_CLIENT_ID/SECRET 才會生效）
# STUDENT_LOGIN_REQUIRED=true
# 隨喜贊助：LINE Pay 收款連結；或把收款 QR 圖存成 app/static/img/sponsor-qr.png
# SPONSOR_LINE_URL=https://...
